<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MosaicAnnotator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="Mosaic Annotator">

    <Grid x:Name="RootGrid" PreviewKeyDown="RootGrid_PreviewKeyDown" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Command Bar -->
        <Grid Grid.Row="0" Padding="10" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">

                    <!-- File Operations -->
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Button x:Name="LoadImageButton" Content="Load Image" Click="LoadImageButton_Click"/>
                        <Button x:Name="LoadDirectoryButton" Content="Load Directory" Click="LoadDirectoryButton_Click"/>
                    </StackPanel>

                    <AppBarSeparator VerticalAlignment="Center"/>

                    <!-- Navigation -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Content="&lt;" Click="PrevButton_Click" IsEnabled="False"/>
                        <TextBlock x:Name="FileStatusText" Text="0 / 0" VerticalAlignment="Center" Width="60" TextAlignment="Center"/>
                        <Button x:Name="NextButton" Content="&gt;" Click="NextButton_Click" IsEnabled="False"/>
                    </StackPanel>

                    <AppBarSeparator VerticalAlignment="Center"/>

                    <!-- Crop Size -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Crop Size" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CropSizeComboBox" SelectedIndex="1" SelectionChanged="CropSizeComboBox_SelectionChanged" Width="80">
                            <ComboBoxItem Content="256"/>
                            <ComboBoxItem Content="512"/>
                            <ComboBoxItem Content="768"/>
                            <ComboBoxItem Content="1024"/>
                        </ComboBox>
                    </StackPanel>

                    <AppBarSeparator VerticalAlignment="Center"/>

                    <!-- Image Adjustments -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Contrast" VerticalAlignment="Center"/>
                        <Slider x:Name="ContrastSlider" Minimum="0" Maximum="2" Value="1" StepFrequency="0.1" Width="100" VerticalAlignment="Center" ValueChanged="ContrastSlider_ValueChanged"/>

                        <TextBlock Text="Shadows" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Slider x:Name="ShadowSlider" Minimum="0" Maximum="1" Value="0" StepFrequency="0.1" Width="80" VerticalAlignment="Center" ValueChanged="ShadowSlider_ValueChanged"/>

                        <TextBlock Text="Sharpen" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Slider x:Name="SharpenSlider" Minimum="0" Maximum="10" Value="0" StepFrequency="0.5" Width="100" VerticalAlignment="Center" ValueChanged="Filter_ValueChanged"/>
                    </StackPanel>

                    <AppBarSeparator VerticalAlignment="Center"/>

                    <!-- Rendering Modes -->
                    <ToggleButton x:Name="EmbossToggle" Content="Emboss Mode" Click="Filter_Click" VerticalAlignment="Center"/>

                    <AppBarSeparator VerticalAlignment="Center"/>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="ExportButton" Content="Export Crop &amp; Mask" Click="ExportButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                        <Button x:Name="ClearButton" Content="Clear Annotations" Click="ClearButton_Click" Foreground="IndianRed"/>
                    </StackPanel>

                    <!-- File Name Display -->
                    <TextBlock x:Name="FileNameText" Text="" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Main Workspace -->
        <ScrollViewer x:Name="ImageScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" ZoomMode="Enabled">
            <!-- Renamed WorkspaceGrid to ImageWorkArea to match the C# centering logic -->
            <Grid x:Name="ImageWorkArea" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Win2D Canvas for hardware-accelerated image drawing and effects -->
                <canvas:CanvasControl x:Name="ImageCanvas" Draw="ImageCanvas_Draw" CreateResources="ImageCanvas_CreateResources"/>

                <!-- Transparent UI Canvas for the custom lines and reticle -->
                <Canvas x:Name="OverlayCanvas" Background="Transparent" 
                        PointerPressed="OverlayCanvas_PointerPressed" 
                        PointerMoved="OverlayCanvas_PointerMoved" 
                        PointerReleased="OverlayCanvas_PointerReleased"
                        PointerWheelChanged="OverlayCanvas_PointerWheelChanged">
                </Canvas>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>