<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MosaicAnnotator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="Mosaic Annotator">

    <Grid x:Name="RootGrid" PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Command Bar -->
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Load Buttons -->
                <ColumnDefinition Width="Auto"/>
                <!-- Prev -->
                <ColumnDefinition Width="Auto"/>
                <!-- Status (1 / 10) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Next -->
                <ColumnDefinition Width="Auto"/>
                <!-- Margin -->
                <ColumnDefinition Width="Auto"/>
                <!-- Crop Size -->
                <ColumnDefinition Width="Auto"/>
                <!-- Contrast -->
                <ColumnDefinition Width="Auto"/>
                <!-- Export -->
                <ColumnDefinition Width="Auto"/>
                <!-- Clear (NEW) -->
                <ColumnDefinition Width="*"/>
                <!-- Spacer -->
                <ColumnDefinition Width="Auto"/>
                <!-- Filename -->
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,10,0">
                <Button x:Name="LoadImageButton" Content="Load Image" Click="LoadImageButton_Click" Margin="0,0,10,0"/>
                <Button x:Name="LoadDirectoryButton" Content="Load Directory" Click="LoadDirectoryButton_Click"/>
            </StackPanel>

            <Button x:Name="PrevButton" Content="&lt;" Click="PrevButton_Click" Grid.Column="1" IsEnabled="False"/>
            <TextBlock x:Name="FileStatusText" Text="0 / 0" VerticalAlignment="Center" Margin="10,0" Grid.Column="2"/>
            <Button x:Name="NextButton" Content="&gt;" Click="NextButton_Click" Grid.Column="3" IsEnabled="False"/>

            <StackPanel Orientation="Horizontal" Grid.Column="5" Margin="20,0,0,0">
                <TextBlock Text="Crop Size" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="CropSizeComboBox" SelectedIndex="1" SelectionChanged="CropSizeComboBox_SelectionChanged">
                    <ComboBoxItem Content="256"/>
                    <ComboBoxItem Content="512"/>
                    <ComboBoxItem Content="768"/>
                    <ComboBoxItem Content="1024"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="6" Margin="20,0,0,0">
                <!-- 1. Your Original Contrast Slider -->
                <TextBlock Text="Image Contrast" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider x:Name="ContrastSlider" Minimum="0" Maximum="2" StepFrequency="0.1" Value="1" Width="150" ValueChanged="ContrastSlider_ValueChanged"/>
                <!-- 2. New Shadow Lift Slider -->
                <TextBlock Text="Shadows" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <Slider x:Name="ShadowSlider" Minimum="0" Maximum="1" StepFrequency="0.1" Value="0" Width="70" ValueChanged="ShadowSlider_ValueChanged"/>
                <!-- 3. New X-Ray Toggle -->
                <ToggleButton x:Name="EdgeModeToggle" Content="X-Ray" Margin="10,0,0,0" Padding="5,4" Click="EdgeModeToggle_Click" />
            </StackPanel>

            <Button x:Name="ExportButton" Content="Export Crop &amp; Mask" Click="ExportButton_Click" Grid.Column="7" Margin="20,0,0,0"/>

            <!-- NEW: Clear Annotations Button -->
            <Button x:Name="ClearButton" Content="Clear Annotations" Click="ClearButton_Click" Grid.Column="8" Margin="10,0,0,0" Foreground="IndianRed"/>

            <TextBlock x:Name="FileNameText" Text="" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="10" Margin="0,0,20,0" FontWeight="Bold"/>
        </Grid>

        <!-- Main Workspace -->
        <ScrollViewer x:Name="ImageScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" ZoomMode="Enabled">
            <!-- Renamed WorkspaceGrid to ImageWorkArea to match the C# centering logic -->
            <Grid x:Name="ImageWorkArea" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Win2D Canvas for hardware-accelerated image drawing and effects -->
                <canvas:CanvasControl x:Name="ImageCanvas" Draw="ImageCanvas_Draw" CreateResources="ImageCanvas_CreateResources"/>

                <!-- Transparent UI Canvas for the custom lines and reticle -->
                <Canvas x:Name="OverlayCanvas" Background="Transparent" 
                        PointerPressed="OverlayCanvas_PointerPressed" 
                        PointerMoved="OverlayCanvas_PointerMoved" 
                        PointerReleased="OverlayCanvas_PointerReleased"
                        PointerWheelChanged="OverlayCanvas_PointerWheelChanged">
                </Canvas>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>